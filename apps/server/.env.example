# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS). Dev defaults shown.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (PostgreSQL on the same host for v1) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=telugu_sambandham
PGUSER=postgres
PGPASSWORD=changeme
# Optional single connection string (overrides the PG* vars above if set)
# DATABASE_URL=postgres://postgres:changeme@localhost:5432/telugu_sambandham

# --- Sessions ---
# Long random string used to sign the session cookie.
SESSION_SECRET=change-this-to-a-long-random-string
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Set true in production (HTTPS only). Keep false for local http dev.
COOKIE_SECURE=false

# --- Email (OTP + notifications) ---
# EMAIL_DRIVER: "console" (dev: prints codes to the terminal) or "smtp" (real send).
EMAIL_DRIVER=console
EMAIL_FROM_NAME=Telugu Sambandham
EMAIL_FROM_ADDRESS=CustomerSupport@telugusambandham.com
# SMTP settings (used only when EMAIL_DRIVER=smtp). For Gmail: host smtp.gmail.com, port 465, secure true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=telugusambandham@gmail.com
# Put the Gmail App Password here in your real .env ONLY. Never commit it.
SMTP_PASS=

# --- OTP policy ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Business settings defaults (also seeded into the settings table; DB is source of truth) ---
CONTACT_UNLOCK_PRICE=25
# ISO date; while now < this date, contact unlock is FREE (launch promo).
CONTACT_UNLOCK_FREE_UNTIL=2026-12-31
PHONE_VIEW_DAILY_LIMIT=5
MAX_PHOTOS_PER_USER=3

# --- Uploads ---
UPLOAD_DIR=./uploads
